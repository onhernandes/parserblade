{
  "name": "parserblade",
  "version": "2.0.0",
  "description": "The easiest parser for JSON, XML, CSV and YAML. Use it as simple as JSON.stringify() or JSON.parse(). All in one place.",
  "homepage": "https://onhernandes.github.io/parserblade",
  "author": {
    "name": "Matheus Hernandes",
    "email": "",
    "url": "onhernandes.github.io"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/parserblade.cjs.js",
  "module": "dist/parserblade.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/parserblade.es.js",
      "require": "./dist/parserblade.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "parserblade": "dist/cli/index.js"
  },
  "keywords": [
    "parser",
    "data-parser",
    "stream",
    "stream-parser",
    "streaming-parser",
    "csv-parser",
    "csv-parser-stream",
    "csv-stringify",
    "csv-stringify-stream",
    "transform-csv",
    "csv-streaming",
    "csv",
    "yaml-parser",
    "yaml-stringify",
    "yaml-stringify-stream",
    "yaml-parser-stream",
    "transform-yaml",
    "yaml",
    "xml-parser",
    "xml-stringify",
    "xml-parser-stream",
    "xml-stringify-stream",
    "transform-xml",
    "xml",
    "json",
    "json-parser",
    "json-stringify",
    "json-stringify-stream",
    "json-parser-stream",
    "typescript"
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonstream": "^0.8.33",
    "@types/node": "^20.19.1",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">= 16.0.0",
    "npm": ">= 8.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test:run && npm run build"
  },
  "repository": "git@github.com:onhernandes/parserblade.git",
  "license": "MIT",
  "dependencies": {
    "@types/joi": "^17.2.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "csv-parse": "^5.5.2",
    "csv-stringify": "^6.4.4",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "JSONStream": "^1.3.5",
    "node-xml-stream": "^1.0.2",
    "xml-js": "^1.6.11",
    "zod": "^3.25.67"
  }
}
